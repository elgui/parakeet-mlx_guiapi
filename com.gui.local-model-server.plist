<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local Model Server — GATEWAY (front door).

  FastAPI gateway (local_model_server.py) on 127.0.0.1:8123. Proxies /v1/models +
  /v1/chat/completions + /v1/completions to the engine (llama.cpp on :8124) for
  text/image/audio chat, and adapts /v1/audio/transcriptions -> gemma audio chat so the
  Parakeet daemon (and any OpenAI client) gets clean transcription.

  Install:  cp com.gui.local-model-server.plist ~/Library/LaunchAgents/ && chmod 600 ~/Library/LaunchAgents/com.gui.local-model-server.plist
  Start:    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.gui.local-model-server.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gui.local-model-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gui/dev/parakeet-mlx_guiapi/.venv/bin/python3</string>
        <string>/Users/gui/dev/parakeet-mlx_guiapi/local_model_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gui/dev/parakeet-mlx_guiapi</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LMS_HOST</key>
        <string>127.0.0.1</string>
        <key>LMS_PORT</key>
        <string>8123</string>
        <key>LMS_BACKEND_URL</key>
        <string>http://127.0.0.1:8124/v1</string>
        <key>LMS_DEFAULT_MODEL</key>
        <string>gemma-4-12B-it-QAT-Q4_0.gguf</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gui/dev/parakeet-mlx_guiapi/local_model_server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gui/dev/parakeet-mlx_guiapi/local_model_server.log</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
